RAG_APP_NAME=rag-hallucination-detector
RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=llama3
RAG_FAITHFULNESS_THRESHOLD=0.62
RAG_SIMILARITY_THRESHOLD=0.38
RAG_VERIFICATION_THRESHOLD=0.45
RAG_FALLBACK_STRATEGY=regenerate
RAG_ENABLE_MLFLOW=true
RAG_MLFLOW_TRACKING_URI=file:./mlruns

